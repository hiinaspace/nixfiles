 use warn_once;
+/// Sprint Vector render debugging: log the first few hits of a call site, then every 900th.
+macro_rules! sv_dbg {
+    ($($tt:tt)*) => {{
+        static HITS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+        let n = HITS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        if n < 6 || n % 900 == 0 {
+            log::info!("[SVDBG #{n}] {}", format_args!($($tt)*));
+        }
+    }}
+}
+use sv_dbg;
 
 #[cfg(feature = "tracing")]
 macro_rules! tracy_span {
