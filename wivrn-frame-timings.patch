 void wivrn_session::operator()(from_headset::feedback && feedback)
 {
+	// Opt-in export of the same headset feedback used by the timing graph.
+	static std::ofstream timing_csv = [] {
+		std::ofstream file;
+		if (const char * path = std::getenv("WIVRN_FRAME_TIMINGS"))
+		{
+			file.open(path);
+			if (!file)
+				U_LOG_W("Cannot open WIVRN_FRAME_TIMINGS file");
+			else
+				file << "frame,stream,encode_begin,encode_end,send_begin,send_end,receive_begin,receive_end,decode_begin,decode_end,blit,display,times_displayed\n";
