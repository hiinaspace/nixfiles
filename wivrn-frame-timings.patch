+		           << feedback.send_begin << ',' << feedback.send_end << ','
+		           << feedback.received_first_packet << ',' << feedback.received_last_packet << ','
+		           << feedback.sent_to_decoder << ',' << feedback.received_from_decoder << ','
+		           << feedback.blitted << ',' << feedback.displayed << ','
+		           << unsigned(feedback.times_displayed) << '\n';
+	}
